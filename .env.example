# ==============================================================================
# SIH 26154: Content Transformation Platform — Root Environment Example
# ==============================================================================
# This file serves as a reference template for local development environment variables.
# Real credentials must never be committed to source control.

# Application Environment Mode (development | test | production)
NODE_ENV=development

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=3000

# Backend Configuration
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Gemini AI GenAI Engine Configuration (Server-Side Only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
