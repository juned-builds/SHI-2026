# Backend Environment Variables Template
# Copy this file to .env for local backend development

# Application Configuration
PROJECT_NAME="Content Transformation API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api"

# CORS Configuration (Comma-separated list of origins)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Future Module Configuration Placeholders (NOT active in Module 0.1)
# GEMINI_API_KEY=
# DATABASE_URL=
