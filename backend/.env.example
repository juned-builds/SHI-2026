# Backend Environment Variables Template
# Copy this file to .env for local backend development

# Application Configuration
PROJECT_NAME="Content Transformation API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api"

# CORS Configuration (Comma-separated list of origins)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Gemini AI Configuration (Server-Side Only)
GEMINI_API_KEY=
GEMINI_MODEL="gemini-3.7-flash"
MAX_SOURCE_LENGTH=150000
